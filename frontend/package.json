{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "start-backend-windows": "cd ../backend && venv\\Scripts\\activate.bat && uvicorn main:app --reload --port 5000",
    "start-backend-unix": "cd ../backend && source venv/bin/activate && uvicorn main:app --reload --port 5000",
    "dev-all": "concurrently \"npm run start-backend-windows\" \"npm run dev\"",
    "dev-all-unix": "concurrently \"npm run start-backend-unix\" \"npm run dev\""
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.2.0",
    "@tanstack/react-query": "^5.81.5",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "axios": "^1.10.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.5.2",
    "react-router-dom": "^7.0.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "autoprefixer": "^10.4.24",
    "concurrently": "^9.2.0",
    "eslint": "^10.0.0",
    "globals": "^16.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.2.0",
    "vite": "^7.0.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true
  }
}
