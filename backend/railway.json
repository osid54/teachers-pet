{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pip install -r requirements.txt"
  },
  "deploy": {
    "preDeployCommand": ["python -m alembic upgrade head"],
    "startCommand": "python main.py",
    "healthcheckPath": "/",
    "healthcheckTimeout": 300
  }
}
